# Copy this file to .env and fill in the values.
# On Render these are set in the dashboard under Environment instead.

# Required: get one from https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Optional: override the model used by every agent
# GEMINI_MODEL=gemini-3.5-flash-lite

# Optional: comma-separated list of frontend origins allowed to call the API.
# Defaults to * (any origin), which is fine for local development.
# ALLOWED_ORIGINS=http://localhost:5173,https://your-app.onrender.com

# Optional: local only, never enable on a public deployment
# FLASK_DEBUG=1
